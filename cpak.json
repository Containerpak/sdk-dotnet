{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v3.json",
  "manifest_version": "3.0",
  "name": ".NET SDK",
  "description": ".NET SDK, C# compiler and development tools.",
  "version": "9.0.317",
  "image": "ghcr.io/containerpak/sdk-dotnet@sha256:51d6de3e2f45864c5bb68ba9e0dee2aee14c250036b420e85a7fe1db0ee91cbc",
  "binaries": [
    "/usr/local/bin/dotnet"
  ],
  "desktop_entries": [],
  "dependencies": [],
  "addons": [],
  "addon_provider": {
    "id": "dotnet",
    "slot": "sdk.dotnet",
    "mode": "exclusive",
    "exports": {
      "path": [
        "/usr/local/bin"
      ],
      "environment": [
        "DOTNET_ROOT=/opt/dotnet"
      ]
    }
  },
  "idle_time": 0,
  "override": {
    "socketWayland": false,
    "socketPulseAudio": false,
    "socketSshAgent": true,
    "socketCups": false,
    "socketGpgAgent": true,
    "deviceDri": false,
    "deviceKvm": false,
    "deviceShm": false,
    "deviceAlsa": false,
    "deviceVideo": false,
    "deviceFuse": false,
    "deviceTun": false,
    "deviceUsb": false,
    "deviceSerial": false,
    "deviceInput": false,
    "deviceTTY": false,
    "deviceAll": false,
    "notification": false,
    "openURI": false,
    "hostApplications": false,
    "filePicker": {},
    "filesystem": [
      {
        "path": "home",
        "access": "read-write"
      }
    ],
    "network": true,
    "process": false,
    "userNamespaces": false,
    "memoryMaxMB": 0,
    "cpuQuota": 0,
    "pidsMax": 0,
    "asRoot": false
  }
}
