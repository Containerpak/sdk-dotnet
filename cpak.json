{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v2.json",
  "manifest_version": "2.0",
  "name": ".NET SDK",
  "description": ".NET SDK, C# compiler and development tools.",
  "version": "9.0.317",
  "image": "ghcr.io/containerpak/sdk-dotnet:main",
  "binaries": ["/usr/local/bin/dotnet"],
  "desktop_entries": [],
  "dependencies": [],
  "addons": [],
  "addon_provider": {
    "id": "dotnet",
    "slot": "sdk.dotnet",
    "mode": "exclusive",
    "exports": {
      "path": ["/usr/local/bin"],
      "environment": ["DOTNET_ROOT=/opt/dotnet"]
    }
  },
  "idle_time": 0,
  "override": {
    "socketX11": false,
    "socketWayland": false,
    "socketPulseAudio": false,
    "socketSessionBus": false,
    "socketSystemBus": false,
    "socketSshAgent": true,
    "socketCups": false,
    "socketGpgAgent": true,
    "socketAtSpiBus": false,
    "socketBluetooth": false,
    "deviceDri": false,
    "deviceKvm": false,
    "deviceShm": false,
    "deviceAlsa": false,
    "deviceVideo": false,
    "deviceFuse": false,
    "deviceTun": false,
    "deviceUsb": false,
    "deviceSerial": false,
    "deviceInput": false,
    "deviceTTY": false,
    "deviceAll": false,
    "notification": false,
    "openURI": false,
    "hostApplications": false,
    "filePicker": {},
    "filesystem": [{"path": "home", "access": "read-write"}],
    "network": true,
    "process": false,
    "userNamespaces": false,
    "memoryMaxMB": 0,
    "cpuQuota": 0,
    "pidsMax": 0,
    "asRoot": false
  }
}
